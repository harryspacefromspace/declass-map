{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "declass-map",
  "main": "worker.js",
  "compatibility_date": "2026-07-01",

  // Access policies apply to a hostname, so every OTHER hostname that reaches
  // this Worker is an unauthenticated way in. Both of these are on by default:
  //   workers_dev  -> declass-map.<subdomain>.workers.dev
  //   preview_urls -> a public URL per deployment
  // Turned off so declass-map.spacefromspace.com is the only front door.
  "workers_dev": false,
  "preview_urls": false,

  "assets": {
    // Only ./dist is published. The repo root also holds scenes.db, monitor.py
    // and the raw scene file, none of which should ever be served — build-dist
    // copies in an allowlist rather than publishing the root.
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    // Everything else is served straight from assets without waking the Worker;
    // only /data/* needs it.
    "run_worker_first": ["/data/*"]
  },

  // Scene data lives in a private bucket with no public access and no custom
  // domain — readable only through this binding, from our own Worker.
  "r2_buckets": [
    { "binding": "SCENES", "bucket_name": "declass-map-data" }
  ]
}
